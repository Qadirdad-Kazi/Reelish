{
  "name": "reelish",
  "version": "1.0.0",
  "description": "A modern social media platform similar to TikTok",
  "scripts": {
    "update-urls": "node update-urls.js",
    "verify-deployment": "node verify-deployment-config.js",
    "deploy:backend": "cd server && vercel --prod",
    "deploy:frontend": "cd client && netlify deploy --prod",
    "build:all": "npm run build --prefix server && npm run build --prefix client"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "firebase": "^11.8.1",
    "pg": "^8.16.0",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
