# Exclude development and build artifacts
.git
.gitignore
*.log

# Exclude client files (deployed separately to Netlify)
client/

# Exclude server dev files
server/node_modules
server/dist
server/uploads
server/scripts
server/*.test.ts
server/*.test.js
server/*.spec.ts
server/*.spec.js

# Exclude uploads directory
uploads/

# Exclude other non-essential files
.vscode
.idea
*.md
README.md
LICENSE
.DS_Store
.env.local
.env.development
.env.test

# Exclude root node_modules (we install in api folder)
node_modules/
